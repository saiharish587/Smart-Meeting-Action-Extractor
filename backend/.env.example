# Smart Meeting Action Extractor — Backend Environment Configuration
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is already listed in .gitignore.
#
# ── Required for real AI inference ───────────────────────────────────────────
# Obtain your key from: https://aisuite.cirrascale.com/
QUALCOMM_API_KEY=your_api_key_here

# ── Optional overrides ────────────────────────────────────────────────────────
# Uncomment to change from the defaults below.
# QUALCOMM_ENDPOINT=https://aisuite.cirrascale.com/apis/v2
# QUALCOMM_MODEL=Llama-3.1-8B
# MOCK_MODE=false
# MAX_NOTES_CHARS=16000
# REQUEST_TIMEOUT_S=90
# ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,null
